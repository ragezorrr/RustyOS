# Maintainer: RustyOS Contributors
# Native Arch Linux / EndeavourOS package recipe (`RUSTYOS-076`, ADR-0036).
# Usage:
#   From local git checkout: cd packaging/arch && makepkg -si
#   Rollback / remove cleanly: sudo pacman -Rns rustyos-git

pkgname=rustyos-git
pkgver=0.1.0.r77.g4702baa
pkgrel=1
pkgdesc='Independent Linux desktop environment in Rust (Wayland compositor, dock, shell, and apps)'
arch=('x86_64' 'aarch64')
url='https://github.com/ragezorrr/RustyOS'
license=('MIT' 'Apache-2.0')
depends=(
  'wayland'
  'libxkbcommon'
  'mesa'
  'libglvnd'
  'libinput'
  'systemd-libs'
  'seatd'
  'dbus'
  'fontconfig'
  'ttf-jetbrains-mono'
  'noto-fonts'
  'noto-fonts-emoji'
  'xorg-xwayland'
  'pipewire'
  'pipewire-alsa'
  'pipewire-pulse'
  'wireplumber'
  'alsa-utils'
  'alsa-ucm-conf'
  'sof-firmware'
  'xdg-desktop-portal'
  'polkit'
  'pacman-contrib'
  'squashfs-tools'
)
makedepends=('rust' 'cargo' 'git' 'pkgconf')
optdepends=(
  'firefox: optional Mozilla web browser'
  'sddm: graphical Wayland session login chooser'
  'greetd: minimal login manager alternative'
  'plymouth: flicker-free graphical boot splash screen'
  'networkmanager: Wi-Fi status and network toggles in Control Center'
  'bluez: Bluetooth toggle and device status in Control Center'
  'upower: battery and power supply status in TopBar'
  'xdg-desktop-portal-gtk: file chooser and portal fallback backend'
)
provides=('rustyos')
conflicts=('rustyos')
options=('!debug' '!lto')
source=()
sha256sums=()

_repo_root() {
  if [[ -d "${startdir}/../../.git" ]]; then
    printf '%s\n' "$(cd "${startdir}/../.." && pwd)"
  else
    printf '%s\n' "${srcdir}"
  fi
}

pkgver() {
  local root
  root="$(_repo_root)"
  if [[ -d "${root}/.git" ]]; then
    local rev
    rev="$(git -C "${root}" rev-list --count HEAD 2>/dev/null || echo 0)"
    local sha
    sha="$(git -C "${root}" rev-parse --short HEAD 2>/dev/null || echo 0000000)"
    printf '0.1.0.r%s.g%s\n' "${rev}" "${sha}"
  else
    printf '0.1.0\n'
  fi
}

prepare() {
  local root
  root="$(_repo_root)"
  export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
  if [[ -f "${root}/Cargo.lock" ]]; then
    cargo fetch --locked --manifest-path "${root}/Cargo.toml"
  fi
}

build() {
  local root
  root="$(_repo_root)"
  export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${srcdir}/target}"
  export RUSTYOS_PACKAGED_BUILD=1
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src/debug/${pkgname} --remap-path-prefix=${root}=/usr/src/debug/${pkgname}"
  cargo build --release --locked --workspace --manifest-path "${root}/Cargo.toml"
}

check() {
  local root
  root="$(_repo_root)"
  export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${srcdir}/target}"
  export RUSTYOS_PACKAGED_BUILD=1
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/usr/src/debug/${pkgname} --remap-path-prefix=${root}=/usr/src/debug/${pkgname}"
  cargo test --workspace --locked --manifest-path "${root}/Cargo.toml" -- --test-threads=1
}

package() {
  local root target_dir pw_worker
  root="$(_repo_root)"
  target_dir="${CARGO_TARGET_DIR:-${srcdir}/target}/release"

  install -d \
    "${pkgdir}/usr/bin" \
    "${pkgdir}/usr/lib/rustyos" \
    "${pkgdir}/usr/lib/systemd/user" \
    "${pkgdir}/usr/share/applications" \
    "${pkgdir}/usr/share/polkit-1/actions" \
    "${pkgdir}/usr/share/wayland-sessions" \
    "${pkgdir}/usr/share/xdg-desktop-portal/portals" \
    "${pkgdir}/usr/share/rustyos/wallpapers" \
    "${pkgdir}/usr/share/plymouth/themes/rustyos" \
    "${pkgdir}/usr/share/grub/themes/rustyos" \
    "${pkgdir}/usr/share/doc/${pkgname}"

  install -m755 "${target_dir}/rusty-compositor" "${pkgdir}/usr/bin/rusty-compositor"
  install -m755 "${target_dir}/rusty-files" "${pkgdir}/usr/bin/rusty-files"
  install -m755 "${target_dir}/rusty-settings" "${pkgdir}/usr/bin/rusty-settings"
  install -m755 "${target_dir}/rusty-terminal" "${pkgdir}/usr/bin/rusty-terminal"
  install -m755 "${target_dir}/rusty-view" "${pkgdir}/usr/bin/rusty-view"
  install -m755 "${target_dir}/rusty-greeter" "${pkgdir}/usr/bin/rusty-greeter"
  install -m755 "${target_dir}/rusty-installer" "${pkgdir}/usr/bin/rusty-installer"
  install -m755 "${target_dir}/rustyos-update-helper" \
    "${pkgdir}/usr/lib/rustyos/rustyos-update-helper"
  install -m755 "${target_dir}/rustyos-installer-service" \
    "${pkgdir}/usr/lib/rustyos/rustyos-installer-service"
  install -m755 "${root}/scripts/rustyos-install.sh" \
    "${pkgdir}/usr/lib/rustyos/rustyos-install"
  install -m755 "${root}/bin/rustyos-session" "${pkgdir}/usr/bin/rustyos-session"

  pw_worker="$(ls -1t "${target_dir}"/build/rusty-services-*/out/rusty-pipewire-stream 2>/dev/null | head -n 1 || true)"
  if [[ -n "${pw_worker}" && -x "${pw_worker}" ]]; then
    install -m755 "${pw_worker}" "${pkgdir}/usr/bin/rusty-pipewire-stream"
  fi

  install -m644 "${root}/packaging/applications/org.rustyos.files.desktop" \
    "${pkgdir}/usr/share/applications/org.rustyos.files.desktop"
  install -m644 "${root}/packaging/applications/org.rustyos.settings.desktop" \
    "${pkgdir}/usr/share/applications/org.rustyos.settings.desktop"
  install -m644 "${root}/packaging/applications/org.rustyos.terminal.desktop" \
    "${pkgdir}/usr/share/applications/org.rustyos.terminal.desktop"
  install -m644 "${root}/packaging/applications/org.rustyos.view.desktop" \
    "${pkgdir}/usr/share/applications/org.rustyos.view.desktop"
  install -m644 "${root}/packaging/applications/org.rustyos.updater.desktop" \
    "${pkgdir}/usr/share/applications/org.rustyos.updater.desktop"
  install -m644 "${root}/packaging/applications/org.rustyos.installer.desktop" \
    "${pkgdir}/usr/share/applications/org.rustyos.installer.desktop"
  install -m644 "${root}/packaging/applications/rustyos-mimeapps.list" \
    "${pkgdir}/usr/share/applications/rustyos-mimeapps.list"
  install -m644 "${root}/packaging/polkit/org.rustyos.updater.policy" \
    "${pkgdir}/usr/share/polkit-1/actions/org.rustyos.updater.policy"
  install -m644 "${root}/packaging/polkit/org.rustyos.installer.policy" \
    "${pkgdir}/usr/share/polkit-1/actions/org.rustyos.installer.policy"

  install -m644 "${root}/packaging/portals/rustyos.portal" \
    "${pkgdir}/usr/share/xdg-desktop-portal/portals/rustyos.portal"
  install -m644 "${root}/packaging/portals/rustyos-portals.conf" \
    "${pkgdir}/usr/share/xdg-desktop-portal/rustyos-portals.conf"

  install -m644 "${root}/packaging/systemd/user/rustyos-session.target" \
    "${pkgdir}/usr/lib/systemd/user/rustyos-session.target"
  install -m644 "${root}/packaging/systemd/user/rustyos-session-shutdown.target" \
    "${pkgdir}/usr/lib/systemd/user/rustyos-session-shutdown.target"
  install -m644 "${root}/packaging/systemd/user/rustyos-polkit.service" \
    "${pkgdir}/usr/lib/systemd/user/rustyos-polkit.service"
  install -Dm644 "${root}/packaging/arch/rustyos-greeter.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/rustyos-greeter.conf"

  sed 's|^Exec=.*|Exec=/usr/bin/rustyos-session|' \
    "${root}/packaging/wayland-sessions/rustyos.desktop" \
    > "${pkgdir}/usr/share/wayland-sessions/rustyos.desktop"
  chmod 644 "${pkgdir}/usr/share/wayland-sessions/rustyos.desktop"

  install -m644 "${root}/assets/wallpapers/rustyos-light-4k.png" \
    "${pkgdir}/usr/share/rustyos/wallpapers/rustyos-light-4k.png"
  install -m644 "${root}/assets/wallpapers/rustyos-dark-4k.png" \
    "${pkgdir}/usr/share/rustyos/wallpapers/rustyos-dark-4k.png"

  install -m644 "${root}/packaging/plymouth/rustyos/rustyos.plymouth" \
    "${pkgdir}/usr/share/plymouth/themes/rustyos/rustyos.plymouth"
  install -m644 "${root}/packaging/plymouth/rustyos/rustyos.script" \
    "${pkgdir}/usr/share/plymouth/themes/rustyos/rustyos.script"
  install -m644 "${root}/packaging/plymouth/rustyos/logo.png" \
    "${pkgdir}/usr/share/plymouth/themes/rustyos/logo.png"
  install -m644 "${root}/packaging/plymouth/rustyos/progress_bg.png" \
    "${pkgdir}/usr/share/plymouth/themes/rustyos/progress_bg.png"
  install -m644 "${root}/packaging/plymouth/rustyos/progress_fg.png" \
    "${pkgdir}/usr/share/plymouth/themes/rustyos/progress_fg.png"

  install -m644 "${root}/packaging/grub/rustyos/theme.txt" \
    "${pkgdir}/usr/share/grub/themes/rustyos/theme.txt"
  install -m644 "${root}/packaging/grub/rustyos/logo.png" \
    "${pkgdir}/usr/share/grub/themes/rustyos/logo.png"
  install -m644 "${root}/packaging/grub/rustyos/select_c.png" \
    "${pkgdir}/usr/share/grub/themes/rustyos/select_c.png"

  if [[ -f "${root}/README.md" ]]; then
    install -m644 "${root}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  fi
}
