#!/bin/sh
set -eu

/usr/bin/systemd-sysusers || true

if ! id liveuser >/dev/null 2>&1; then
    /usr/bin/useradd -m -u 1000 -G wheel,audio,input,video,render,seat -s /usr/bin/bash liveuser
fi
/usr/bin/passwd -d liveuser >/dev/null 2>&1 || true
/usr/bin/passwd -d root >/dev/null 2>&1 || true

if ! id greeter >/dev/null 2>&1; then
    /usr/bin/useradd -r -M -G video,render,input -s /usr/bin/nologin greeter
else
    /usr/bin/usermod -aG video,render,input greeter || true
fi

mkdir -p /home/liveuser/.config/rustyos /home/liveuser/Desktop
cp -an /etc/skel/. /home/liveuser/ || true
chown -R 1000:1000 /home/liveuser

ln -sf /usr/share/zoneinfo/UTC /etc/localtime
if [ -f /etc/locale.gen ]; then
    grep -qx 'en_US.UTF-8 UTF-8' /etc/locale.gen || printf '\nen_US.UTF-8 UTF-8\n' >> /etc/locale.gen
    /usr/bin/locale-gen || true
fi

if ! grep -qE '^[[:space:]]*Server[[:space:]]*=' /etc/pacman.d/mirrorlist 2>/dev/null; then
    mkdir -p /etc/pacman.d
    cat <<'EOF' > /etc/pacman.d/mirrorlist
## Default Arch Linux mirrors for RustyOS Live Installer
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
Server = https://berlin.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
EOF
fi

systemctl mask systemd-firstboot.service
systemctl disable getty@tty1.service >/dev/null 2>&1 || true
systemctl disable seatd.service >/dev/null 2>&1 || true
systemctl enable greetd.service NetworkManager.service

id liveuser >/dev/null
id greeter >/dev/null
test -f /home/liveuser/.config/rustyos/config.toml
