#!/bin/sh
# RustyOS Desktop Session Entry Point (`RUSTYOS-014`, ADR-0009)
set -eu

export XDG_CURRENT_DESKTOP=RustyOS
export XDG_SESSION_DESKTOP=RustyOS
export XDG_SESSION_TYPE=wayland

# Find bin directory (relative, PATH, or local cargo build)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SHELL_BIN=""
if [ -x "$SCRIPT_DIR/rusty-compositor" ]; then
    COMPOSITOR_BIN="$SCRIPT_DIR/rusty-compositor"
    SHELL_BIN="$SCRIPT_DIR/rusty-shell"
elif command -v rusty-compositor >/dev/null 2>&1; then
    COMPOSITOR_BIN="$(command -v rusty-compositor)"
    SHELL_BIN="$(command -v rusty-shell 2>/dev/null || true)"
elif [ -x "$SCRIPT_DIR/../target/release/rusty-compositor" ]; then
    COMPOSITOR_BIN="$SCRIPT_DIR/../target/release/rusty-compositor"
    SHELL_BIN="$SCRIPT_DIR/../target/release/rusty-shell"
else
    COMPOSITOR_BIN="$SCRIPT_DIR/../target/debug/rusty-compositor"
    SHELL_BIN="$SCRIPT_DIR/../target/debug/rusty-shell"
fi

if [ ! -x "$COMPOSITOR_BIN" ]; then
    echo "Error: rusty-compositor binary not found at $COMPOSITOR_BIN" >&2
    exit 1
fi

BACKEND_FLAG=""
case "${1:-}" in
    --drm|--kms|--winit|--nested|--drm-probe|--check)
        BACKEND_FLAG="$1"
        shift
        ;;
esac

if [ -z "$BACKEND_FLAG" ]; then
    if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
        BACKEND_FLAG="--drm"
    else
        BACKEND_FLAG="--winit"
    fi
fi

# Discover XDG Desktop Portal configuration cleanly (system, ~/.local user install, or source tree)
if [ -z "${XDG_DESKTOP_PORTAL_DIR:-}" ]; then
    USER_PORTAL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/xdg-desktop-portal/portals"
    if [ -f "$USER_PORTAL_DIR/rustyos.portal" ]; then
        export XDG_DESKTOP_PORTAL_DIR="$USER_PORTAL_DIR"
    elif [ ! -f /usr/share/xdg-desktop-portal/portals/rustyos.portal ] \
        && [ -f "$SCRIPT_DIR/../packaging/portals/rustyos.portal" ]; then
        export XDG_DESKTOP_PORTAL_DIR="$SCRIPT_DIR/../packaging/portals"
    fi
fi

# Sync session desktop variables into systemd/D-Bus user environment only for standalone sessions.
if [ "$BACKEND_FLAG" = "--drm" ] || [ "$BACKEND_FLAG" = "--kms" ]; then
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --systemd \
            XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
            ${XDG_DESKTOP_PORTAL_DIR:+XDG_DESKTOP_PORTAL_DIR} \
            >/dev/null 2>&1 || true
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user try-restart xdg-desktop-portal.service >/dev/null 2>&1 || true
    fi
fi

echo "Starting RustyOS Desktop Session (Backend: $BACKEND_FLAG)..."
if [ "$BACKEND_FLAG" != "--check" ] && [ "$BACKEND_FLAG" != "--drm-probe" ] \
    && [ -n "$SHELL_BIN" ] && [ -x "$SHELL_BIN" ]; then
    exec "$COMPOSITOR_BIN" "$BACKEND_FLAG" --spawn "$SHELL_BIN" "$@"
fi
exec "$COMPOSITOR_BIN" "$BACKEND_FLAG" "$@"
