#!/bin/sh
# RustyOS Desktop Session Entry Point (`RUSTYOS-014`, ADR-0009)
set -eu

export XDG_CURRENT_DESKTOP=RustyOS
export XDG_SESSION_DESKTOP=RustyOS
export XDG_SESSION_TYPE=wayland

# Client toolkit defaults for native Wayland execution (RUSTYOS-084)
: "${QT_QPA_PLATFORM:=wayland;xcb}"
: "${QT_WAYLAND_DISABLE_WINDOWDECORATION:=1}"
: "${GDK_BACKEND:=wayland,x11,*}"
: "${MOZ_ENABLE_WAYLAND:=1}"
: "${ELECTRON_OZONE_PLATFORM_HINT:=auto}"
: "${SDL_VIDEODRIVER:=wayland,x11}"
: "${CLUTTER_BACKEND:=wayland}"
: "${_JAVA_AWT_WM_NONREPARENTING:=1}"
: "${XCURSOR_THEME:=RustyOS}"
: "${XCURSOR_SIZE:=24}"
export QT_QPA_PLATFORM QT_WAYLAND_DISABLE_WINDOWDECORATION GDK_BACKEND MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT SDL_VIDEODRIVER CLUTTER_BACKEND _JAVA_AWT_WM_NONREPARENTING XCURSOR_THEME XCURSOR_SIZE

# Find bin directory (sibling install -> PATH -> local cargo release/debug)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

find_rusty_bin() {
    name="$1"
    if [ -x "$SCRIPT_DIR/$name" ]; then
        printf '%s\n' "$SCRIPT_DIR/$name"
        return 0
    fi
    if [ -f "$REPO_ROOT/Cargo.toml" ]; then
        for cand in \
            "$REPO_ROOT/target/release/$name" \
            "$REPO_ROOT/target/debug/$name"; do
            if [ -x "$cand" ]; then
                printf '%s\n' "$cand"
                return 0
            fi
        done
    fi
    if command -v "$name" >/dev/null 2>&1; then
        command -v "$name"
        return 0
    fi
    return 0
}

COMPOSITOR_BIN="$(find_rusty_bin rusty-compositor)"
FILES_BIN="$(find_rusty_bin rusty-files)"
SETTINGS_BIN="$(find_rusty_bin rusty-settings)"
TERMINAL_BIN="$(find_rusty_bin rusty-terminal)"
INSTALLER_BIN="$(find_rusty_bin rusty-installer)"
PW_WORKER_BIN="$(find_rusty_bin rusty-pipewire-stream)"
if [ -z "$PW_WORKER_BIN" ]; then
    for cand in \
        "$REPO_ROOT"/target/release/build/rusty-services-*/out/rusty-pipewire-stream \
        "$REPO_ROOT"/target/debug/build/rusty-services-*/out/rusty-pipewire-stream; do
        if [ -x "$cand" ]; then
            PW_WORKER_BIN="$cand"
            break
        fi
    done
fi

HELPER_BIN=""
for cand in \
    "/usr/lib/rustyos/rustyos-update-helper" \
    "${HOME:-/tmp}/.local/lib/rustyos/rustyos-update-helper" \
    "$SCRIPT_DIR/../lib/rustyos/rustyos-update-helper" \
    "$REPO_ROOT/target/release/rustyos-update-helper" \
    "$REPO_ROOT/target/debug/rustyos-update-helper"; do
    if [ -x "$cand" ]; then
        HELPER_BIN="$cand"
        break
    fi
done

run_doctor() {
    ok_count=0
    warn_count=0
    fail_count=0

    doc_ok() {
        ok_count=$((ok_count + 1))
        printf '[OK]   %s\n' "$1"
    }
    doc_warn() {
        warn_count=$((warn_count + 1))
        printf '[WARN] %s\n' "$1"
    }
    doc_fail() {
        fail_count=$((fail_count + 1))
        printf '[FAIL] %s\n' "$1"
    }

    printf '=== RustyOS Session & Arch Readiness Doctor (--doctor) ===\n'
    printf 'User: %s (uid=%s) | Desktop target: %s\n' "${USER:-unknown}" "$(id -u)" "${XDG_CURRENT_DESKTOP}"

    for spec in \
        "rusty-compositor:$COMPOSITOR_BIN:req:build workspace or install package" \
        "rusty-files:$FILES_BIN:req:build workspace or install package" \
        "rusty-settings:$SETTINGS_BIN:req:build workspace or install package" \
        "rusty-terminal:$TERMINAL_BIN:req:build workspace or install package" \
        "rusty-installer:$INSTALLER_BIN:warn:optional macOS-style OS installer & OOBE" \
        "rusty-pipewire-stream:$PW_WORKER_BIN:warn:optional ScreenCast PipeWire worker" \
        "rustyos-update-helper:$HELPER_BIN:warn:required at /usr/lib/rustyos/rustyos-update-helper for live pkexec upgrades"; do
        name="${spec%%:*}"
        rest="${spec#*:}"
        bin_path="${rest%%:*}"
        rest="${rest#*:}"
        sev="${rest%%:*}"
        hint="${rest#*:}"
        if [ -n "$bin_path" ] && [ -x "$bin_path" ]; then
            doc_ok "Binary $name: $bin_path"
        elif [ "$sev" = "req" ]; then
            doc_fail "Missing executable binary $name ($hint)"
        else
            doc_warn "Binary $name unavailable ($hint)"
        fi
    done

    for cmd in Xwayland dbus-update-activation-environment pkexec pacman; do
        if command -v "$cmd" >/dev/null 2>&1; then
            doc_ok "System command $cmd: $(command -v "$cmd")"
        else
            doc_fail "Missing system command '$cmd'"
        fi
    done
    if command -v checkupdates >/dev/null 2>&1; then
        doc_ok "Arch update checker: $(command -v checkupdates)"
    else
        doc_warn "Missing 'checkupdates' (install 'pacman-contrib' for menu-bar updates indicator)"
    fi

    for sys_asset in \
        "/usr/share/wayland-sessions/rustyos.desktop:${HOME:-/tmp}/.local/share/wayland-sessions/rustyos.desktop:wayland-session desktop" \
        "/usr/share/applications/org.rustyos.files.desktop:${HOME:-/tmp}/.local/share/applications/org.rustyos.files.desktop:rusty-files .desktop" \
        "/usr/share/applications/org.rustyos.settings.desktop:${HOME:-/tmp}/.local/share/applications/org.rustyos.settings.desktop:rusty-settings .desktop" \
        "/usr/share/applications/org.rustyos.terminal.desktop:${HOME:-/tmp}/.local/share/applications/org.rustyos.terminal.desktop:rusty-terminal .desktop" \
        "/usr/share/applications/org.rustyos.updater.desktop:${HOME:-/tmp}/.local/share/applications/org.rustyos.updater.desktop:rusty-updater .desktop" \
        "/usr/share/applications/org.rustyos.installer.desktop:${HOME:-/tmp}/.local/share/applications/org.rustyos.installer.desktop:rusty-installer .desktop" \
        "/usr/share/xdg-desktop-portal/portals/rustyos.portal:${XDG_DATA_HOME:-${HOME:-/tmp}/.local/share}/xdg-desktop-portal/portals/rustyos.portal:XDG portal registration" \
        "/usr/lib/systemd/user/rustyos-session.target:${HOME:-/tmp}/.local/share/systemd/user/rustyos-session.target:systemd session target" \
        "/usr/lib/systemd/user/rustyos-session-shutdown.target:${HOME:-/tmp}/.local/share/systemd/user/rustyos-session-shutdown.target:systemd shutdown target"; do
        p1="${sys_asset%%:*}"
        r1="${sys_asset#*:}"
        p2="${r1%%:*}"
        lbl="${r1##*:}"
        if [ -f "$p1" ]; then
            doc_ok "$lbl: $p1"
        elif [ -f "$p2" ]; then
            doc_ok "$lbl (user install): $p2"
        else
            doc_warn "$lbl not installed yet (checked $p1 and $p2)"
        fi
    done

    for tk_var in QT_QPA_PLATFORM GDK_BACKEND MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT SDL_VIDEODRIVER; do
        val="$(eval "printf '%s' \"\${$tk_var:-}\"")"
        if [ -n "$val" ]; then
            doc_ok "Toolkit default $tk_var: $val"
        else
            doc_warn "Toolkit variable $tk_var unset"
        fi
    done

    if [ -f /usr/share/polkit-1/actions/org.rustyos.updater.policy ]; then
        doc_ok "Polkit policy: /usr/share/polkit-1/actions/org.rustyos.updater.policy"
    else
        doc_warn "Polkit policy missing at /usr/share/polkit-1/actions/org.rustyos.updater.policy (required for live updates)"
    fi

    if command -v systemctl >/dev/null 2>&1; then
        for unit in dbus polkit NetworkManager bluetooth upower seatd systemd-logind; do
            if systemctl is-active --quiet "$unit" 2>/dev/null; then
                doc_ok "System service '$unit' is active"
            else
                doc_warn "System service '$unit' not active (optional unless needed on target hardware)"
            fi
        done
        for uunit in pipewire wireplumber xdg-desktop-portal; do
            if systemctl --user is-active --quiet "$uunit" 2>/dev/null; then
                doc_ok "User service '$uunit' is active"
            else
                doc_warn "User service '$uunit' not active in current shell"
            fi
        done
    fi

    if [ -e /dev/dri/card0 ] || [ -e /dev/dri/card1 ] || ls /dev/dri/card* >/dev/null 2>&1; then
        doc_ok "DRM devices present: $(ls -1 /dev/dri/card* /dev/dri/renderD* 2>/dev/null | tr '\n' ' ')"
    else
        doc_fail "No /dev/dri/card* devices found"
    fi

    if [ -n "$COMPOSITOR_BIN" ] && [ -x "$COMPOSITOR_BIN" ]; then
        if "$COMPOSITOR_BIN" --drm-probe >/dev/null 2>&1; then
            doc_ok "Compositor '--drm-probe' passed (KMS / GBM / EGL / DMA-BUF ready)"
        else
            doc_fail "Compositor '--drm-probe' failed (run '$COMPOSITOR_BIN --drm-probe' for details)"
        fi
    fi

    printf '=== Doctor Summary: %s ok, %s warn, %s fail ===\n' "$ok_count" "$warn_count" "$fail_count"
    [ "$fail_count" -eq 0 ]
}

case "${1:-}" in
    --help|-h)
        echo "Usage: $0 [--drm|--kms|--winit|--nested|--drm-probe|--check|--doctor] [-- <compositor-args>]"
        exit 0
        ;;
    --doctor)
        run_doctor
        exit 0
        ;;
esac

if [ ! -x "$COMPOSITOR_BIN" ]; then
    echo "Error: rusty-compositor binary not found at $COMPOSITOR_BIN" >&2
    exit 1
fi

BACKEND_FLAG=""
case "${1:-}" in
    --drm|--kms|--winit|--nested|--drm-probe|--check)
        BACKEND_FLAG="$1"
        shift
        ;;
esac

if [ -z "$BACKEND_FLAG" ]; then
    if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
        BACKEND_FLAG="--drm"
    else
        BACKEND_FLAG="--winit"
    fi
fi

# Discover XDG Desktop Portal configuration cleanly (system, ~/.local user install, or source tree)
if [ -z "${XDG_DESKTOP_PORTAL_DIR:-}" ]; then
    USER_PORTAL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/xdg-desktop-portal/portals"
    if [ -f "$USER_PORTAL_DIR/rustyos.portal" ]; then
        export XDG_DESKTOP_PORTAL_DIR="$USER_PORTAL_DIR"
    elif [ ! -f /usr/share/xdg-desktop-portal/portals/rustyos.portal ] \
        && [ -f "$SCRIPT_DIR/../packaging/portals/rustyos.portal" ]; then
        export XDG_DESKTOP_PORTAL_DIR="$SCRIPT_DIR/../packaging/portals"
    fi
fi

cleanup_session() {
    exit_code=$?
    trap - EXIT INT TERM HUP
    echo "Shutting down RustyOS Desktop Session..."
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user stop rustyos-session.target >/dev/null 2>&1 || true
        systemctl --user stop graphical-session.target >/dev/null 2>&1 || true
        systemctl --user start --no-block rustyos-session-shutdown.target >/dev/null 2>&1 || true
    fi
    exit "$exit_code"
}

ensure_runtime_environment() {
    if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
        XDG_RUNTIME_DIR="/run/user/$(id -u)"
    fi
    if [ ! -d "$XDG_RUNTIME_DIR" ]; then
        mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
        chmod 0700 "$XDG_RUNTIME_DIR" 2>/dev/null || true
    fi
    if [ ! -d "$XDG_RUNTIME_DIR" ] || [ ! -w "$XDG_RUNTIME_DIR" ]; then
        XDG_RUNTIME_DIR="/tmp/rustyos-runtime-$(id -u)"
        mkdir -p "$XDG_RUNTIME_DIR"
        chmod 0700 "$XDG_RUNTIME_DIR"
    fi
    export XDG_RUNTIME_DIR

    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR}/bus" ]; then
        DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
        export DBUS_SESSION_BUS_ADDRESS
    fi

    if [ "$BACKEND_FLAG" = "--drm" ] || [ "$BACKEND_FLAG" = "--kms" ]; then
        if [ -z "${LIBSEAT_BACKEND:-}" ] && [ -n "${XDG_SESSION_ID:-}" ] && [ -d /run/systemd/system ]; then
            export LIBSEAT_BACKEND=logind
        fi
        : "${RUST_LOG:=info}"
        export RUST_LOG
    fi
}

run_drm_compositor() {
    LOG_FILE="${XDG_RUNTIME_DIR}/rustyos-session.log"
    LOG_FIFO="${XDG_RUNTIME_DIR}/rustyos-session.fifo.$$"
    LATEST_ERR_LOG="/tmp/rustyos-session-last-error.log"

    {
        printf '=== RustyOS DRM/KMS session start (%s) ===\n' "$(date -Is 2>/dev/null || date)"
        printf 'user=%s uid=%s XDG_SESSION_ID=%s XDG_RUNTIME_DIR=%s LIBSEAT_BACKEND=%s\n' \
            "$(id -un)" "$(id -u)" "${XDG_SESSION_ID:-unset}" "$XDG_RUNTIME_DIR" "${LIBSEAT_BACKEND:-auto}"
        ls -la /dev/dri/ 2>&1 || true
    } >"$LOG_FILE" 2>&1 || true

    rm -f "$LATEST_ERR_LOG" 2>/dev/null || true

    if rm -f "$LOG_FIFO" && mkfifo "$LOG_FIFO" 2>/dev/null; then
        tee -a "$LOG_FILE" <"$LOG_FIFO" >&2 &
        TEE_PID=$!
        set +e
        if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
            dbus-run-session -- "$COMPOSITOR_BIN" "$BACKEND_FLAG" "$@" >"$LOG_FIFO" 2>&1
        else
            "$COMPOSITOR_BIN" "$BACKEND_FLAG" "$@" >"$LOG_FIFO" 2>&1
        fi
        drm_rc=$?
        set -e
        wait "$TEE_PID" >/dev/null 2>&1 || true
        rm -f "$LOG_FIFO" 2>/dev/null || true
    else
        set +e
        if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
            dbus-run-session -- "$COMPOSITOR_BIN" "$BACKEND_FLAG" "$@"
        else
            "$COMPOSITOR_BIN" "$BACKEND_FLAG" "$@"
        fi
        drm_rc=$?
        set -e
    fi

    if [ "$drm_rc" -ne 0 ]; then
        {
            printf 'RustyOS DRM/KMS compositor exited with code %s.\n' "$drm_rc"
            tail -n 40 "$LOG_FILE" 2>/dev/null || true
        } >"$LATEST_ERR_LOG" 2>/dev/null || true
        chmod 0644 "$LATEST_ERR_LOG" 2>/dev/null || true
        printf 'Error: RustyOS compositor exited with code %s (see %s)\n' "$drm_rc" "$LOG_FILE" >&2
    fi
    return "$drm_rc"
}

if [ "$BACKEND_FLAG" != "--check" ] && [ "$BACKEND_FLAG" != "--drm-probe" ]; then
    ensure_runtime_environment
fi

# Sync session desktop and toolkit variables into systemd/D-Bus user environment for standalone sessions.
if [ "$BACKEND_FLAG" = "--drm" ] || [ "$BACKEND_FLAG" = "--kms" ]; then
    if command -v dbus-update-activation-environment >/dev/null 2>&1; then
        dbus-update-activation-environment --systemd \
            XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
            QT_QPA_PLATFORM QT_WAYLAND_DISABLE_WINDOWDECORATION \
            GDK_BACKEND MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT \
            SDL_VIDEODRIVER CLUTTER_BACKEND _JAVA_AWT_WM_NONREPARENTING \
            XCURSOR_THEME XCURSOR_SIZE \
            ${XDG_DESKTOP_PORTAL_DIR:+XDG_DESKTOP_PORTAL_DIR} \
            >/dev/null 2>&1 || true
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user import-environment \
            XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
            QT_QPA_PLATFORM QT_WAYLAND_DISABLE_WINDOWDECORATION \
            GDK_BACKEND MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT \
            SDL_VIDEODRIVER CLUTTER_BACKEND _JAVA_AWT_WM_NONREPARENTING \
            XCURSOR_THEME XCURSOR_SIZE \
            >/dev/null 2>&1 || true
        systemctl --user try-restart xdg-desktop-portal.service >/dev/null 2>&1 || true
        systemctl --user start pipewire.service pipewire-pulse.service wireplumber.service >/dev/null 2>&1 || true
        systemctl --user start rustyos-session.target >/dev/null 2>&1 || true
    fi
    trap cleanup_session EXIT INT TERM HUP
fi

echo "Starting RustyOS Desktop Session (Backend: $BACKEND_FLAG)..."
OOBE_SPAWN_ARG=""
OOBE_MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/rustyos/.oobe-pending"
if [ "${RUSTYOS_SKIP_OOBE:-0}" != "1" ] \
    && [ "$BACKEND_FLAG" != "--check" ] \
    && [ "$BACKEND_FLAG" != "--drm-probe" ] \
    && [ -f "$OOBE_MARKER" ] \
    && [ -n "$INSTALLER_BIN" ] \
    && [ -x "$INSTALLER_BIN" ]; then
    OOBE_SPAWN_ARG="$INSTALLER_BIN --oobe"
fi

if [ -n "$OOBE_SPAWN_ARG" ]; then
    set -- --spawn "$OOBE_SPAWN_ARG" "$@"
fi

if [ "$BACKEND_FLAG" = "--drm" ] || [ "$BACKEND_FLAG" = "--kms" ]; then
    run_drm_compositor "$@"
    exit $?
else
    exec "$COMPOSITOR_BIN" "$BACKEND_FLAG" "$@"
fi
